# Nenhuma variável é necessária para rodar o protótipo.
# Abaixo, as variáveis previstas para quando houver integrações reais (deixe vazio por enquanto).

# Banco de dados (ex.: Postgres)
DATABASE_URL=

# Autenticação (ex.: Auth.js)
AUTH_SECRET=

# Stripe (cartão internacional e Pix)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Fornecedor print-on-demand (printful | printify | gelato)
POD_PROVIDER=
POD_API_KEY=
